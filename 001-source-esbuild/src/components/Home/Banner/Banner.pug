section#home.section-home-banner
    div(class="relative bg-Utility/white")
        .swiper.swiper-home-banner
            .swiper-wrapper
                .swiper-slide(data-type="video")
                    video(muted playsinline autoplay loop class="w-full h-full object-cover")
                        source(src="./img/banner-vid.mp4" type="video/mp4")
                .swiper-slide(data-type="image")
                    div(class="w-full h-full")
                        +PugImg("./img/banner2.png")(class="w-full h-full object-cover")
                .swiper-slide(data-type="image")
                    div(class="w-full h-full")
                        +PugImg("./img/banner2.png")(class="w-full h-full object-cover")

            div(class="absolute bottom-0 w-full h-[calc(419/1920*100rem)] bg-[linear-gradient(0deg,_#016048_0%,_rgba(1,_108,_81,_0.00)_100%)] z-10 pointer-events-none flex items-end justify-center")
                div(class="flex flex-col py-10 items-center gap-3 xl:gap-7")
                    div(class="banner-title-wrapper")
                        div(class="banner-title text-[calc(60/1920*100rem)]") SỐNG CHẤT TINH HOA
                        div(class="banner-title text-[calc(40/1920*100rem)]") VƯỢT XA GIÁ TRỊ 
                    div(class="flex items-center gap-3 pointer-events-auto")
                        .btn-prev
                            i.fa-light.fa-arrow-left-long
                        .btn-next
                            i.fa-light.fa-arrow-right-long
