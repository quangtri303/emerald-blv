section#news.section-news
    .section-py
        div(class="container-fluid flex flex-col gap-4 xl:gap-10")
            div(class="heading-1 text-Primary/1 uppercase self-stretch text-center") Tin tức
            .swiper.swiper-news.w-full
                .swiper-wrapper
                    each item in news
                        .swiper-slide
                            a.news-item(href="#")
                                .news-img
                                    +PugImg(item.img)(class="w-full h-full object-cover")
                                .news-info
                                    .news-date=item.date
                                    .news-title=item.title
            div(class="w-full flex gap-3 justify-center")
                .btn-prev
                    i.fa-light.fa-arrow-left-long
                .btn-next
                    i.fa-light.fa-arrow-right-long
