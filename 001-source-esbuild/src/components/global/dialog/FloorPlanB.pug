include ../../mixin.pug

-
    var floorMaps = [
        { label: "Tầng 6", image: "./img/lv1-map.svg" },
        { label: "Tầng 7 - 19", image: "./img/lv1-map.svg" },
        { label: "Tầng 21 - 39", image: "./img/lv1-map.svg" },
    ]
dialog#floorPlanB(open class="floorplan h-full w-full p-0")
    div(class="container-fluid flex flex-col md:flex-row h-full justify-center items-center gap-4 xl:gap-[calc(107/1920*100rem)]")
        div(class="w-full md:w-[55%] xl:w-[67.1%]")
            .floorplan-map-stage
                each map, index in floorMaps
                    .floorplan-map-panel(class=index === 0 ? "active" : "" data-floor-panel=index)
                        img(src=map.image alt="" class="w-full h-full object-contain")
        div(class="w-full md:flex-[1_0_0] flex flex-col items-start justify-end gap-4 md:gap-[calc(136/1920*100rem)]")
            div(class="flex flex-col gap-3 xl:gap-6 w-full")
                div(class="heading-1 text-Primary/1") MẶT BẰNG TẦNG b
                ul.floor-tabs(class="rounded-full border border-Primary/1 p-1 relative flex w-full" style=`--floor-count: ${floorMaps.length}`)
                    each map, index in floorMaps
                        li.floor(class=index === 0 ? "active" : "" data-floor-index=index)
                            div=map.label
                    +SlidingTabBg("floor-bg")
            ul.apt-types
                li
                    .apt-color(class="bg-[#FEF8C8]")
                    .apt-name Căn hộ Studio
                li
                    .apt-color(class="bg-[#FEF8C8]")
                    .apt-name Căn hộ 1 phòng ngủ
                li
                    .apt-color(class="bg-[#FEF8C8]")
                    .apt-name Căn hộ 2 phòng ngủ
                li
                    .apt-color(class="bg-[#FEF8C8]")
                    .apt-name Căn hộ 3 phòng ngủ
