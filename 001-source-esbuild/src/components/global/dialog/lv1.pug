include ../../mixin.pug

dialog#lv1(open class="h-full w-full p-0")
    div(class="container-fluid flex flex-col md:flex-row h-full justify-center items-center gap-4 xl:gap-[calc(107/1920*100rem)]")
        div(class="w-full md:w-[55%] xl:w-[67.1%]")
            img(src="./img/lv1-map.svg" alt="" class="w-full h-full object-contain")
        div(class="w-full md:flex-[1_0_0] flex flex-col items-start justify-end gap-4 md:gap-[calc(136/1920*100rem)]")
            div(class="flex flex-col gap-3 xl:gap-6")
                div(class="heading-1 text-Primary/1") MẶT BẰNG TẦNG
                ul.floor-tabs(class="rounded-full border border-Primary/1 p-1 relative flex w-full")
                    li.floor.active(data-floor-index="0")
                        div Tầng 6
                    li.floor(data-floor-index="1")
                        div Tầng 7 - 19
                    li.floor(data-floor-index="2")
                        div Tầng 21 - 39
                    +SlidingTabBg("floor-bg")
                a(href="./dialog/lv2.html" data-fancybox data-type="ajax") lv2
            ul.apt-types
                li
                    .apt-color(class="bg-[#FEF8C8]")
                    .apt-name Căn hộ Studio
