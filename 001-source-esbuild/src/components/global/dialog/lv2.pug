include ../../mixin.pug

-
    var apts = [
        "./img/lv2-img.png",
        "./img/lv2-img.png",
        "./img/lv2-img.png",
    ]
dialog#lv2(open class="h-full w-full p-0 bg-Primary/1")
    div(class="container h-full w-full flex flex-col py-8.5 max-w-[calc(1133/1920*100rem)] justify-center items-center gap-6")
        div(class="flex flex-col gap-2 justify-center items-center w-full")
            div(class="heading-1 text-Utility/white uppercase") Tháp a
            ul.floor-tabs(class="rounded-full border border-Utility/white p-1 relative flex")
                li.floor.active(data-floor-index="0")
                    div Tầng 6
                li.floor(data-floor-index="1")
                    div Tầng 7 - 19
                li.floor(data-floor-index="2")
                    div Tầng 21 - 39
                +SlidingTabBg("floor-bg")
        div(class="flex flex-col gap-3 w-full relative")
            div(class="swiper swiper-apt w-full")
                .swiper-wrapper
                    each apt in apts 
                        .swiper-slide
                            div(class="apt-img-wrapper")
                                img(src=apt)
            div(class="md:absolute top-1/2 md:-translate-y-1/2 w-full z-10 flex gap-4 justify-center md:justify-between")
                .btn-prev(class="md:translate-x-5 xl:-translate-x-15")
                    i.fa-light.fa-arrow-left-long
                .btn-next(class="md:-translate-x-5 xl:translate-x-15")
                    i.fa-light.fa-arrow-right-long
            div(class="body-3 text-Utility/white italic") * Chúng tôi đã nỗ lực và cẩn trọng để hoàn thiện tài liệu này. Tuy nhiên tài liệu chỉ dùng với mục đích tham khảo. Hình ảnh, sơ đồ kỹ thuật, mã căn hộ, bố trí nội ngoại thất hay thông tin mô tả chỉ nhằm mục đích mình họa, không phải là thông tin hiện thực hay cam kết pháp lý. Thông tin chính thức được căn cứ trên hợp đồng.
        a(href="/dialog/lv3.html" data-fancybox="dialog-lv3" data-type="ajax" class="flex gap-2 rounded-full bg-Utility/white text-Primary/1 items-center justify-center px-6 body-1 h-12 hover:bg-Primary/3 transition-colors duration-300")
            div Hình ảnh nhà mẫu
            i.fa-light.fa-arrow-right-long
