-
    var imgs = ["/img/area-bg.png", "/img/banner2.png", "/img/area-bg.png", "/img/banner2.png", "/img/area-bg.png", "/img/banner2.png", "/img/banner2.png"]

dialog#lv3(open class="h-full w-full p-0 bg-Primary/1")
    div(class="lv3-dialog w-full h-full flex flex-col items-center justify-center gap-5 z-10")
        div(class="heading-1 text-Utility/white uppercase") CHI TIẾT CĂN HỘ
        div.lv3-slider
            div.lv3-slider-viewport
                div.lv3-slider-track
                    each img, index in imgs
                        div.lv3-slide(class=index === initialIndex ? "active" : "" data-slide-index=index)
                            div.lv3-slide-media
                                img(src=img alt="" draggable="false")
            div.lv3-slider-controls
                .lv3-prev
                    i.fa-light.fa-arrow-left-long
                .lv3-next
                    i.fa-light.fa-arrow-right-long
